#!/usr/bin/env bash
# Scans this repo's history for secrets with gitleaks (.gitleaks.toml).
# Uses a local gitleaks if installed, else the official image (pinned release) through Docker.
# Usage: bin/scan-secrets [extra gitleaks args, e.g. --log-opts="origin/main..HEAD"]
set -euo pipefail
cd "$(dirname "$0")/.."
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --config .gitleaks.toml --redact --verbose "$@" .
fi
exec docker run --rm -v "$PWD:/repo" -w /repo ghcr.io/gitleaks/gitleaks:v8.30.1 \
  git --config .gitleaks.toml --redact --verbose "$@" /repo
