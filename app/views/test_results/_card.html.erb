<% failed = result.status == "failed" %>
<% failing = TestResult::FAILING_STATUSES.include?(result.status) %>
<details class="bg-neutral-wh rounded-md border border-neutral-bdr shadow-card" <%= "open" if failed %>>
  <summary class="flex items-center gap-3 px-4 py-3 cursor-pointer list-none">
    <%= status_dot(result.status) %>
    <span class="flex-1 font-medium"><%= result.test_case.full_name %></span>
    <% if local_assigns[:shard_label].present? %><span data-shard-tag class="text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-lt text-neutral-dk"><%= shard_label %></span><% end %>
    <% if local_assigns[:tag] %><%= failure_tag_pill(tag) %>
    <% elsif local_assigns[:verdict]&.flaky %><%= status_pill("flaky") %><% end %>
    <% if local_assigns[:group] %><%= link_to "Group · #{group_size} tests", project_error_path(result.run.project, group), data: { testid: "group-pill" }, class: "#{UiHelper::PILL_BASE} bg-ruby-sub text-ruby" %><% end %>
    <% if result.status == "quarantined" %><%= status_pill("quarantined") %><% end %>
    <% if result.attempts > 1 %><span class="text-xs text-neutral-mid"><%= result.attempts %> attempts</span><% end %>
    <span class="text-xs text-neutral-mid"><%= result.duration_ms %> ms</span>
    <%= link_to "History", project_test_case_path(result.run.project, result.test_case), class: "text-xs text-ruby" %>
  </summary>
  <div class="px-4 pb-4 space-y-3">
    <% if failing %>
      <% images = result.attachments.select { |a| a.content_type.to_s.start_with?("image/") } %>
      <% shot = images.find { |a| result.attachment_name(a) == "screenshot" } || images.first %>
      <% videos = result.attachments.select { |a| a.content_type.to_s.start_with?("video/") } %>
      <% others = result.attachments.to_a - [ shot ] - videos %>
      <% location = failure_location(result.app_frame) %>
      <% frames = result.backtrace.to_s.split("\n").reject(&:blank?) %>
      <div class="<%= shot ? "grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]" : "" %>">
        <% if shot %>
          <div>
            <img src="<%= attachment_path(shot) %>" alt="<%= result.attachment_name(shot) %>"
                 data-action="click->lightbox#open"
                 class="w-full rounded-sm border border-neutral-bdr cursor-zoom-in hover:shadow-card-hover">
          </div>
        <% end %>
        <div class="space-y-3 min-w-0">
          <div class="rounded-md bg-status-err-bg p-3">
            <p class="text-xs font-semibold text-status-err mb-1"><%= result.exception_class %></p>
            <pre class="text-sm whitespace-pre-wrap text-neutral-dark"><%= result.failure_message %></pre>
          </div>
          <% if location %>
            <% browser = result.run.environment.is_a?(Hash) ? result.run.environment["browser"].presence : nil %>
            <p data-testid="failure-location" title="<%= result.app_frame %>" class="text-xs text-neutral-mid">Failed at <code class="font-mono text-neutral-dark"><%= location %></code><% if browser %> · <%= browser %><% end %></p>
          <% end %>
          <% if frames.any? %>
            <details data-testid="stack-trace">
              <summary class="text-xs text-neutral-mid cursor-pointer">Stack trace</summary>
              <div class="mt-2 text-xs font-mono bg-neutral-lt rounded-md p-3 overflow-x-auto">
                <% fold_frames(frames, result.app_frame).each do |segment| %>
                  <% if segment[:kind] == :project %>
                    <span data-testid="stack-frame-project" class="block whitespace-pre bg-ruby-sub text-ruby"><%= segment[:text] %></span>
                  <% else %>
                    <details data-testid="stack-frames-folded">
                      <summary class="cursor-pointer text-neutral-mid">… <%= segment[:lines].size %> more</summary>
                      <% segment[:lines].each do |line| %><span class="block whitespace-pre text-neutral-mid"><%= line %></span><% end %>
                    </details>
                  <% end %>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </div>
      <% if videos.any? %>
        <details>
          <summary class="text-xs text-neutral-mid cursor-pointer">Failure video</summary>
          <div class="mt-2 flex flex-wrap gap-3">
            <% videos.each do |video| %>
              <figure class="space-y-1">
                <video controls preload="metadata" src="<%= attachment_path(video) %>" class="h-48 rounded-sm"></video>
                <figcaption class="text-xs text-neutral-mid"><%= result.attachment_name(video) %></figcaption>
              </figure>
            <% end %>
          </div>
        </details>
      <% end %>
      <% if others.any? %>
        <div class="flex flex-wrap gap-3">
          <% others.each do |attachment| %>
            <%= render "test_results/attachment", result: result, attachment: attachment %>
          <% end %>
        </div>
      <% end %>
    <% elsif result.attachments.any? %>
      <div class="flex flex-wrap gap-3">
        <% result.attachments.each do |attachment| %>
          <%= render "test_results/attachment", result: result, attachment: attachment %>
        <% end %>
      </div>
    <% end %>
    <% if attachments_expired?(result) %>
      <p data-testid="attachments-expired" class="text-xs text-neutral-mid">Attachments expired after <%= Retention.config.attachment_days %> days.</p>
    <% end %>
    <% if result.tags.any? %>
      <div class="flex gap-1"><% result.tags.each do |tag| %><span class="text-[11px] px-2 py-0.5 rounded-sm bg-ruby-sub text-ruby"><%= tag %></span><% end %></div>
    <% end %>
  </div>
</details>
