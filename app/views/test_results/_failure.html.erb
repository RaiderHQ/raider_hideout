<% location = failure_location(result.app_frame) %>
<% frames = result.backtrace.to_s.split("\n").reject(&:blank?) %>
<% videos = local_assigns[:videos] || [] %>
<%# Phone order: message, screenshot, video, backtrace. From md: the screenshot sits in the left column. %>
<div class="grid gap-3 <%= "md:gap-x-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]" if shot %>">
  <div class="space-y-3 min-w-0 <%= "md:col-start-2 md:row-start-1" if shot %>">
    <div class="rounded-md bg-status-err-bg p-3">
      <p class="text-xs font-semibold text-status-err mb-1 break-words"><%= result.exception_class %></p>
      <pre class="text-sm whitespace-pre-wrap break-words text-neutral-dark"><%= result.failure_message %></pre>
    </div>
    <% if location %>
      <% browser = result.run.environment.is_a?(Hash) ? result.run.environment["browser"].presence : nil %>
      <p data-testid="failure-location" title="<%= result.app_frame %>" class="text-xs text-neutral-mid break-words">Failed at <code class="font-mono text-neutral-dark"><%= location %></code><% if browser %> · <%= browser %><% end %></p>
    <% end %>
  </div>
  <% if shot %>
    <div class="min-w-0 md:col-start-1 md:row-start-1 md:row-span-2">
      <img src="<%= attachment_path(shot) %>" alt="<%= result.attachment_name(shot) %>"
           data-action="click->lightbox#open"
           class="max-w-full h-auto w-full rounded-sm border border-neutral-bdr cursor-zoom-in hover:shadow-card-hover">
    </div>
  <% end %>
  <% if videos.any? %>
    <details class="min-w-0 md:col-span-2 md:row-start-3">
      <summary class="inline-flex items-center min-h-11 md:min-h-0 text-xs text-neutral-mid cursor-pointer">Failure video</summary>
      <div class="mt-2 flex flex-wrap gap-3">
        <% videos.each do |video| %>
          <figure class="space-y-1 w-full md:w-auto">
            <video controls preload="metadata" src="<%= attachment_path(video) %>" class="w-full h-auto md:w-auto md:h-48 rounded-sm"></video>
            <figcaption class="text-xs text-neutral-mid"><%= result.attachment_name(video) %></figcaption>
          </figure>
        <% end %>
      </div>
    </details>
  <% end %>
  <% if frames.any? %>
    <details data-testid="stack-trace" class="min-w-0 <%= "md:col-start-2 md:row-start-2" if shot %>">
      <summary class="inline-flex items-center min-h-11 md:min-h-0 text-xs text-neutral-mid cursor-pointer">Backtrace</summary>
      <div class="mt-2 text-xs font-mono bg-neutral-lt rounded-md p-3 overflow-x-auto">
        <% fold_frames(frames, result.app_frame).each do |segment| %>
          <% if segment[:kind] == :project %>
            <span data-testid="stack-frame-project" class="block whitespace-pre bg-ruby-sub text-ruby"><%= segment[:text] %></span>
          <% else %>
            <details data-testid="stack-frames-folded">
              <summary class="inline-flex items-center min-h-11 md:min-h-0 cursor-pointer text-neutral-mid">… <%= segment[:lines].size %> more</summary>
              <% segment[:lines].each do |line| %><span class="block whitespace-pre text-neutral-mid"><%= line %></span><% end %>
            </details>
          <% end %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
