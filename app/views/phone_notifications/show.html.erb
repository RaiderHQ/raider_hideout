<% content_for :title, "Phone notifications · Raider Hideout" %>
<h1 class="text-2xl font-semibold mb-2">Phone notifications</h1>
<p class="text-neutral-dk mb-6">On iPhone and iPad, add Hideout to your Home Screen first (Share → Add to Home Screen). iOS 17.2 or later.</p>

<%= panel(extra: "mb-6") do %>
  <h2 class="text-lg font-semibold mb-4">This device</h2>
  <% if @vapid_error %>
    <p role="alert" class="text-sm text-status-err"><%= @vapid_error %></p>
  <% else %>
  <div data-controller="push" data-push-public-key-value="<%= @public_key %>" data-push-url-value="<%= push_subscriptions_path %>">
    <button type="button" data-action="push#subscribe" class="<%= button_classes(:primary, extra: "w-full md:w-auto") %>">Turn on notifications</button>
    <p role="alert" data-push-target="message" class="mt-3 text-sm text-status-err"></p>
  </div>
  <% end %>
<% end %>

<%= panel(extra: "mb-6") do %>
  <h2 class="text-lg font-semibold mb-4">Your devices</h2>
  <% if @subscriptions.empty? %>
    <p class="text-neutral-mid">No devices yet.</p>
  <% else %>
    <ul class="divide-y divide-neutral-bdr">
      <% @subscriptions.each do |subscription| %>
        <li id="<%= dom_id(subscription) %>" class="flex items-center justify-between gap-3 py-3">
          <span class="font-medium"><%= subscription.device_label %></span>
          <%= button_to "Remove", push_subscription_path(subscription), method: :delete,
                class: button_classes(:danger, extra: "min-w-0"),
                form: { data: { turbo_confirm: "Remove #{subscription.device_label}? It stops getting notifications." } } %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= form_with url: phone_notifications_path, method: :patch, scope: :push_preference, data: { turbo: false } do |f| %>
  <%= panel(extra: "mb-6") do %>
    <h2 class="text-lg font-semibold mb-4">Tell me about</h2>
    <div class="flex flex-col">
      <label class="flex items-center gap-3 min-h-11 text-sm"><%= f.check_box :default_branch_failures, checked: @preference.default_branch_failures, class: "h-5 w-5" %> Failures on a project's default branch</label>
      <label class="flex items-center gap-3 min-h-11 text-sm"><%= f.check_box :new_flaky, checked: @preference.new_flaky, class: "h-5 w-5" %> New flaky tests</label>
      <label class="flex items-center gap-3 min-h-11 text-sm"><%= f.check_box :gate_failures, checked: @preference.gate_failures, class: "h-5 w-5" %> Quality gate failures</label>
    </div>
  <% end %>
  <%= panel(extra: "mb-6") do %>
    <h2 class="text-lg font-semibold mb-4">Projects</h2>
    <% if @projects.empty? %>
      <p class="text-neutral-mid">No projects yet.</p>
    <% else %>
      <div class="flex flex-col">
        <% @projects.each do |project| %>
          <label class="flex items-center gap-3 min-h-11 text-sm">
            <%= hidden_field_tag "shown_project_ids[]", project.id, id: nil %>
            <%= check_box_tag "project_ids[]", project.id, !@muted_ids.include?(project.id), id: "project_ids_#{project.id}", class: "h-5 w-5" %>
            <span class="min-w-0 break-words"><%= project.name %></span>
          </label>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <%= f.submit "Save", class: button_classes(:primary, extra: "w-full md:w-auto") %>
<% end %>
