<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold"><%= @organization.name %></h1>
  <div class="flex gap-3">
    <% if role_at_least?(:member) %>
      <%= link_to "New project", new_project_path(organization_id: @organization.id), class: button_classes(:primary) %>
    <% end %>
    <%= link_to "Members", organization_memberships_path(@organization), class: button_classes(:outline) %>
    <% if role_at_least?(:owner) %>
      <%= link_to "Settings", edit_organization_path(@organization), class: button_classes(:outline) %>
    <% end %>
  </div>
</div>
<% if @projects.empty? %>
  <%= panel(extra: "text-center") do %>
    <p class="text-neutral-dk">No projects in this organization yet.</p>
  <% end %>
<% else %>
  <div id="projects" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @projects.each do |project| %>
      <%= render "projects/card", project: project %>
    <% end %>
  </div>
<% end %>
