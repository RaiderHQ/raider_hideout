<%= link_to project_run_path(run.project, run), id: dom_id(run),
      class: "flex items-center gap-4 px-4 py-3 rounded-md hover:bg-ruby-sub transition-colors" do %>
  <%= status_pill(run.status) %>
  <div class="flex-1 min-w-0">
    <p class="font-medium truncate"><%= run.commit_message.presence || "Run ##{run.id}" %></p>
    <p class="text-xs text-neutral-mid">
      <%= run.branch || "no branch" %><% if run.commit_sha %> · <span class="font-mono"><%= run.commit_sha.first(7) %></span><% end %>
      · <%= time_ago_in_words(run.created_at) %> ago
    </p>
  </div>
  <div class="text-right text-sm">
    <p><span class="text-status-ok"><%= run.passed_count %></span> / <span class="text-status-err"><%= run.failed_count %></span>
       <% if run.flaky_count.positive? %>· <span class="text-accent-gold"><%= run.flaky_count %> flaky</span><% end %></p>
    <p class="text-xs text-neutral-mid"><%= run.duration_ms ? "#{(run.duration_ms / 1000.0).round(1)}s" : "–" %></p>
  </div>
<% end %>
