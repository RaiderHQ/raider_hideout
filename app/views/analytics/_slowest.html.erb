<%= panel(padding: "p-4") do %>
  <section data-testid="analytics-slowest">
    <%= render "analytics/list_header", title: "Slowest", list: "slowest", explore_path: analytics_explore_path(sort: "duration") %>
    <% if (empty = analytics_empty_text(@slowest)) %>
      <p class="text-sm text-neutral-mid"><%= empty %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-neutral-mid">
              <th class="py-1">Test</th><th>File</th><th class="text-right">Average</th><th class="text-right">Max</th>
              <th class="text-right">Runs</th><th class="text-right">Total time</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-bdr">
            <% @slowest.each do |row| %>
              <tr>
                <%= render "analytics/test_cell", test_case: row.test_case %>
                <td class="text-right"><%= analytics_duration(row.avg_duration_ms) %></td>
                <td class="text-right"><%= analytics_duration(row.max_duration_ms) %></td>
                <td class="text-right"><%= row.executed %></td>
                <td class="text-right"><%= analytics_duration(row.total_duration_ms) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>
