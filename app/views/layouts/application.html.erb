<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Raider Hideout" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#C14420">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body <%= tag.attributes(data: { turbo: false }) if content_for?(:no_turbo) %>>
    <nav class="bg-neutral-wh shadow-nav">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <%= link_to root_path, "aria-label": "Raider Hideout", class: "flex items-center gap-2 min-h-11 font-semibold text-neutral-dark" do %>
          <%= image_tag "logo.svg", alt: "", class: "h-8 w-8" %> <span class="hidden sm:inline">Raider Hideout</span>
        <% end %>
        <% if authenticated? %>
          <div class="flex items-center gap-4 text-sm">
            <%= link_to "Projects", root_path, class: "flex items-center min-h-11 text-neutral-dk hover:text-ruby" %>
            <details id="organization-menu" class="relative">
              <summary class="flex items-center min-h-11 cursor-pointer list-none text-neutral-dk hover:text-ruby">Organizations</summary>
              <div class="absolute right-0 mt-2 w-56 bg-neutral-wh rounded-md shadow-card border border-neutral-bdr py-1 z-10">
                <% menu_organizations.each do |organization| %>
                  <%= link_to organization.name, organization_path(organization), class: "block min-h-11 px-4 py-3 text-neutral-dk hover:text-ruby hover:bg-ruby-sub" %>
                <% end %>
                <%= link_to "New organization", new_organization_path, class: "block min-h-11 px-4 py-3 border-t border-neutral-bdr text-ruby hover:bg-ruby-sub" %>
              </div>
            </details>
            <details id="account-menu" class="relative">
              <summary class="flex items-center min-h-11 cursor-pointer list-none text-neutral-dk hover:text-ruby">Account</summary>
              <div class="absolute right-0 mt-2 w-56 bg-neutral-wh rounded-md shadow-card border border-neutral-bdr py-1 z-10">
                <%= link_to "Tokens", personal_tokens_path, class: "block min-h-11 px-4 py-3 text-neutral-dk hover:text-ruby hover:bg-ruby-sub" %>
                <%= button_to "Sign out", session_path, method: :delete, class: "block w-full min-h-11 px-4 py-3 text-left text-neutral-dk hover:text-ruby hover:bg-ruby-sub" %>
              </div>
            </details>
          </div>
        <% end %>
      </div>
    </nav>
    <main class="max-w-6xl mx-auto px-4 py-8 animate-page-enter">
      <% flash.each do |type, message| %>
        <div class="mb-6 rounded-md px-4 py-3 text-sm <%= type == 'alert' ? 'bg-status-err-bg text-status-err' : 'bg-status-ok-bg text-status-ok' %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
