<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Projects</h1>
  <%= link_to "New project", new_project_path, class: button_classes(:primary) %>
</div>
<% if @groups.empty? %>
  <%= panel(extra: "text-center") do %>
    <p class="text-neutral-dk mb-4">No projects yet. Create one to get an API token for CI.</p>
    <%= link_to "Create project", new_project_path, class: button_classes(:outline) %>
  <% end %>
<% else %>
  <% @groups.each do |organization, projects| %>
    <section class="mb-8" id="organization-<%= organization.slug %>">
      <h2 class="text-lg font-semibold mb-3"><%= link_to organization.name, organization_path(organization), class: "hover:text-ruby" %></h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% projects.each do |project| %>
          <%= render "projects/card", project: project %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
