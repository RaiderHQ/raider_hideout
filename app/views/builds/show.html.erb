<% if @open_result_id %><div hidden data-controller="scroll-to-result" data-scroll-to-result-id-value="test_result_<%= @open_result_id %>"></div><% end %>
<div class="mb-6">
  <p class="text-sm text-neutral-mid break-words"><%= link_to current_project.name, project_path(current_project), class: "inline-flex items-center min-h-11 md:min-h-0 hover:text-ruby" %> ·
    <%= link_to "Builds", project_builds_path(current_project), class: "inline-flex items-center min-h-11 md:min-h-0 hover:text-ruby" %></p>
  <h1 class="text-2xl font-semibold flex flex-wrap items-center gap-x-3 gap-y-2"><%= status_pill(@build.status) %> <%= gate_badge(@build, rule_enabled: @gate_rule_enabled) %> <span class="min-w-0 break-words"><%= @build.commit_message.presence || "Build ##{@build.id}" %></span></h1>
</div>
<% pr_url = pull_request_url(@build) %>
<% if pr_url %>
  <div class="mb-6 flex flex-wrap gap-2" data-testid="pr-chips">
    <%= link_to "PR ##{@build.pr_number}", pr_url, class: "inline-flex items-center min-h-11 md:min-h-0 text-[11px] px-2 rounded-sm bg-ruby-sub text-ruby", target: "_blank", rel: "noopener noreferrer" %>
  </div>
<% end %>
<div id="results">
<%= panel(extra: "mb-6 grid grid-cols-2 sm:grid-cols-7 gap-4 text-center") do %>
  <% [["Total", @build.total_count, "text-neutral-dark"], ["Passed", @build.passed_count, "text-status-ok"],
      ["Failed", @build.failed_count, "text-status-err"], ["Skipped", @build.skipped_count + @build.pending_count, "text-neutral-mid"],
      ["Quarantined", @build.quarantined_count, "text-status-quarantine"],
      ["Flaky", @build.flaky_count, "text-accent-gold"], ["Duration", @build.duration_label, "text-neutral-dark"]].each do |label, value, color| %>
    <div data-testid="build-tile"><p class="text-2xl font-semibold <%= color %>"><%= value %></p><p class="text-xs uppercase tracking-wider text-neutral-mid"><%= label %></p></div>
  <% end %>
<% end %>
</div>
<p class="text-xs text-neutral-mid mb-4 break-words">
  <%= @build.branch || "no branch" %><% if @build.commit_sha %> · <span class="font-mono"><%= @build.commit_sha.first(7) %></span><% end %>
  <% if @build.shard_progress %> · <%= @build.shard_progress %> shards<% end %>
  <% if @build.quarantined_count.positive? %> · <span class="text-status-quarantine" data-testid="quarantined-count"><%= @build.quarantined_count %> quarantined</span><% end %>
  <% if @build.ci_url.to_s.match?(%r{\Ahttps?://}i) %> · <%= link_to "#{ci_provider_label(@build)} build", @build.ci_url, class: "inline-flex items-center min-h-11 md:min-h-0 text-ruby", target: "_blank", rel: "noopener noreferrer" %><% end %>
</p>
<%= render "builds/gate", build: @build, report: @gate_report, comparison: @comparison if @gate_report.evaluated? %>
<%= render "builds/comparison", comparison: @comparison, build: @build if @comparison %>
<%= render "builds/error_groups", build: @build, groups: @error_groups, counts: @group_counts, failed: @failed_by_group if @group_counts.values.any? { |n| n >= 2 } %>
<% if @rerun_attempts %>
  <%= render "builds/attempts", summaries: @build.attempt_summaries %>
  <%= render "builds/fixed_by_rerun", fixed: @build.fixed_by_rerun %>
<% end %>
<%= render "builds/shard_strip", runs: @runs, project: current_project, show_attempts: @rerun_attempts %>
<% labels = @runs.size > 1 ? @runs.to_h { |run| [run.id, run.shard_label.presence || "Run ##{run.id}"] } : {} %>
<%= results_expired_notice(@runs) %>
<div data-controller="lightbox" class="space-y-6">
  <% @groups.each do |file, results| %>
    <section>
      <h2 class="font-mono text-sm text-neutral-dk mb-2 break-all"><%= file %></h2>
      <div class="space-y-2">
        <% results.each do |result| %>
          <%= render "test_results/card", result: result, shard_label: labels[result.run_id], verdict: @verdicts[result.test_case_id], open: result.id == @open_result_id,
                 group: (@error_groups[result.error_group_id] if TestResult::FAILING_STATUSES.include?(result.status) && @group_counts[result.error_group_id].to_i >= 2),
                 group_size: @group_counts[result.error_group_id],
                 tag: (failure_tag(result.test_case_id, @comparison, @verdicts, @build.comparison_branch) if result.status == "failed") %>
        <% end %>
      </div>
    </section>
  <% end %>
  <dialog data-lightbox-target="dialog" data-action="click->lightbox#close"
          class="m-auto rounded-lg shadow-elevated p-0 backdrop:bg-neutral-dark/60 max-w-5xl">
    <img data-lightbox-target="image" alt="" class="block max-h-[85vh]">
  </dialog>
</div>
