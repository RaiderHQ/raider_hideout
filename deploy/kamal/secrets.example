# Copy to .kamal/secrets. Each line reads the value from the deployer's shell;
# no value is stored here. Leave a variable unset to skip that feature.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
BACKUP_S3_ACCESS_KEY_ID=$BACKUP_S3_ACCESS_KEY_ID
BACKUP_S3_SECRET_ACCESS_KEY=$BACKUP_S3_SECRET_ACCESS_KEY
SENTRY_DSN=$SENTRY_DSN
# Optional: leave unset to use the secrets generated into the storage volume.
SECRET_KEY_BASE=$SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
# Postgres only (with DB_ADAPTER=postgresql); uncomment with the line in config/deploy.yml.
# DATABASE_URL=$DATABASE_URL
