# Kamal 2 example for Raider Hideout (docs/install/kamal.md).
# Copy to config/deploy.yml and deploy/kamal/secrets.example to .kamal/secrets,
# then export the values below in your shell and run: bin/kamal setup
service: hideout
image: <%= ENV.fetch("KAMAL_REGISTRY_IMAGE") %>

servers:
  web:
    - <%= ENV.fetch("KAMAL_SERVER_IP") %>

proxy:
  host: <%= ENV.fetch("APP_HOST") %>
  app_port: 3000
  # kamal-proxy gets a Let's Encrypt certificate. Behind Cloudflare with an
  # origin certificate instead, replace `ssl: true` with:
  #   ssl:
  #     certificate_pem: CLOUDFLARE_ORIGIN_CERT
  #     private_key_pem: CLOUDFLARE_ORIGIN_KEY
  # and add both names to env.secret and .kamal/secrets.
  ssl: true
  healthcheck:
    path: /up

registry:
  server: <%= ENV.fetch("KAMAL_REGISTRY_SERVER", "ghcr.io") %>
  username: <%= ENV.fetch("KAMAL_REGISTRY_USERNAME") %>
  password:
    - KAMAL_REGISTRY_PASSWORD

env:
  # Every optional setting from docs/install/configuration.md. Unset ones get the
  # app's default; an empty value means unset.
  clear:
    SOLID_QUEUE_IN_PUMA: "1"
    APP_HOST: <%= ENV.fetch("APP_HOST").to_json %>
    HIDEOUT_FORCE_SSL: <%= ENV.fetch("HIDEOUT_FORCE_SSL", "true").to_json %>
    HIDEOUT_ASSUME_SSL: <%= ENV.fetch("HIDEOUT_ASSUME_SSL", "false").to_json %>
    HIDEOUT_OPEN_SIGNUP: <%= ENV.fetch("HIDEOUT_OPEN_SIGNUP", "false").to_json %>
    HIDEOUT_SETUP_CODE: <%= ENV.fetch("HIDEOUT_SETUP_CODE", "").to_json %>
<% if ENV["MAILER_FROM"].to_s.strip != "" %>
    MAILER_FROM: <%= ENV["MAILER_FROM"].to_json %>
<% end %>
    SMTP_ADDRESS: <%= ENV.fetch("SMTP_ADDRESS", "").to_json %>
    SMTP_PORT: <%= ENV.fetch("SMTP_PORT", "587").to_json %>
    DB_ADAPTER: <%= ENV.fetch("DB_ADAPTER", "").to_json %>
    ACTIVE_STORAGE_SERVICE: <%= ENV.fetch("ACTIVE_STORAGE_SERVICE", "local").to_json %>
    S3_ENDPOINT: <%= ENV.fetch("S3_ENDPOINT", "").to_json %>
    S3_REGION: <%= ENV.fetch("S3_REGION", "").to_json %>
    S3_BUCKET: <%= ENV.fetch("S3_BUCKET", "").to_json %>
    S3_FORCE_PATH_STYLE: <%= ENV.fetch("S3_FORCE_PATH_STYLE", "").to_json %>
    BACKUP_BUCKET: <%= ENV.fetch("BACKUP_BUCKET", "").to_json %>
    BACKUP_S3_ENDPOINT: <%= ENV.fetch("BACKUP_S3_ENDPOINT", "").to_json %>
    BACKUP_S3_REGION: <%= ENV.fetch("BACKUP_S3_REGION", "").to_json %>
    RETENTION_ATTACHMENT_DAYS: <%= ENV.fetch("RETENTION_ATTACHMENT_DAYS", "30").to_json %>
    RETENTION_RESULT_DAYS: <%= ENV.fetch("RETENTION_RESULT_DAYS", "90").to_json %>
    SENTRY_TRACES_SAMPLE_RATE: <%= ENV.fetch("SENTRY_TRACES_SAMPLE_RATE", "0").to_json %>
  secret:
    - SMTP_USERNAME
    - SMTP_PASSWORD
    - S3_ACCESS_KEY_ID
    - S3_SECRET_ACCESS_KEY
    - BACKUP_S3_ACCESS_KEY_ID
    - BACKUP_S3_SECRET_ACCESS_KEY
    - SENTRY_DSN
    # Optional: leave unset to use the secrets generated into the storage volume.
    - SECRET_KEY_BASE
    - ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
    - ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
    - ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
    # Postgres: set DB_ADAPTER=postgresql and uncomment this line and the one in
    # .kamal/secrets. Rails refuses an empty DATABASE_URL, so keep it commented for SQLite.
    # - DATABASE_URL

# Holds the databases and storage/hideout-secrets.yml. Back it up.
volumes:
  - hideout_storage:/rails/storage

builder:
  arch: amd64
