# Raider Hideout settings. Every variable: docs/install/configuration.md

# The host name people and CI use to reach this server (add :port if it is not 80/443).
APP_HOST=hideout.example.com
# Image release to run (recommended: pin one, e.g. the version you tested). Default: latest.
# HIDEOUT_VERSION=1.0.0
# Host port for docker compose (container port is always 3000).
# HIDEOUT_PORT=3000
# Keep HTTPS on behind a TLS proxy. Set false only on a trusted network.
# HIDEOUT_FORCE_SSL=true
# Only for a TLS proxy that sends no X-Forwarded-Proto header.
# HIDEOUT_ASSUME_SSL=false
# Fixed setup code instead of the one printed in the log.
# HIDEOUT_SETUP_CODE=
# Let anyone register (needs SMTP). Default: invite-only.
# HIDEOUT_OPEN_SIGNUP=false

# Email (optional). Without it, invites show a link to copy.
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAILER_FROM=Raider Hideout <no-reply@hideout.example.com>

# Attachments in S3-compatible storage (optional; default is the storage volume).
# ACTIVE_STORAGE_SERVICE=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Offsite copies of the nightly backup (optional).
# BACKUP_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Error tracking (optional).
# SENTRY_DSN=
